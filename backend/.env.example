AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Render backend environment. Never commit a filled .env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_ai
FRONTEND_URL=http://localhost:3000
PORT=10000
NODE_ENV=development
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Optional UBL reviewer account. Choose its email and a DIFFERENT password.
BOOTSTRAP_LEARNER_EMAIL=reviewer@example.com
BOOTSTRAP_LEARNER_PASSWORD=replace-with-a-different-unique-password
# Optional. Prepared demos and document extraction do not require a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional new feature providers. Keep these server-only.
IMAGE_MODEL=gpt-image-1
REALTIME_MODEL=gpt-realtime
RESEND_API_KEY=
EMAIL_FROM=
REMINDER_JOB_SECRET=
# SITE_ORIGIN defaults to FRONTEND_URL.
